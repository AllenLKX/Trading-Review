# Public app version shown by lightweight health checks.
NEXT_PUBLIC_APP_VERSION=local-dev

# Public entry used for deployment documentation and future absolute links.
APP_PUBLIC_ORIGIN=http://43.156.228.145

# Private single-user HTTP Basic Auth. Required in production.
# Generate APP_ACCESS_PASSWORD on the server; never commit the real value.
APP_ACCESS_USERNAME=
APP_ACCESS_PASSWORD=

# PostgreSQL connection string for Tencent Cloud Ubuntu deployment.
# Keep this server-side only. Do not expose it to browser code.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/rationaltrade

# Backend M1 starts with a private single-user mode before full login is added.
# Use an id from the profiles table when DATABASE_URL is enabled.
RATIONALTRADE_SINGLE_USER_ID=

# Future server-side AI provider key. Leave empty in local mock mode.
AI_API_KEY=

# Future Tencent Cloud COS configuration for screenshot storage.
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_BUCKET=
TENCENT_COS_REGION=
